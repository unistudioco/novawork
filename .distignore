/.git
/.github
/.gitignore
/.distignore
/.editorconfig
/.dev.env
/.dev.env.example
/.vscode
/.idea
/node_modules
/bin
/build
/tests
/CLAUDE.md
/HANDOFF.md
/README.md
/phpcs.xml.dist
/phpstan.neon.dist
/composer.lock
/package-lock.json
.DS_Store
/playwright.config.js
/test-results
