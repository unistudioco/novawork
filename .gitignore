# Dependencies (installed by composer install / npm install).
/vendor/
/node_modules/

# Built assets (npm run build). The release build ships them.
/assets/dist/

# Release and check builds.
/build/

# Local dev settings (copy .dev.env.example).
/.dev.env

# OS and editor files.
.DS_Store
.idea/
.vscode/
*.log

# Browser test output.
/test-results/
/playwright-report/

# The maintainers' working notes stay private (owner, 2026-11-25).
/CLAUDE.md
/HANDOFF.md
/RELEASE.md
