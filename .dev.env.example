# Local dev settings for bin/plugin-check.sh. Copy to .dev.env (git-ignored).
# Path to the dev site's WordPress root.
NOVAWORK_WP_PATH="$HOME/Local Sites/novawork/app/public"
# Local (localwp.com) runs MySQL on a socket; WP-CLI needs it. Leave empty elsewhere.
NOVAWORK_MYSQL_SOCKET="$HOME/Library/Application Support/Local/run/<site-id>/mysql/mysqld.sock"
# bin/test-http.sh: the dev site URL and two members' logins (local test accounts only).
NOVAWORK_URL="http://novawork.local"
NOVAWORK_USER_A="alex:alex"
NOVAWORK_USER_B="sam:sam"
